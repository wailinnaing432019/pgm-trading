# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:root@localhost:5432/pgm-trading"

# Public canonical URL (used for metadata and the site logo fallback).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin session cookie Secure flag.
# Leave unset to auto-detect from X-Forwarded-Proto. When serving over plain
# HTTP (for example http://EC2-IP:3000 during a smoke test), set this to
# "false", otherwise browsers discard the secure session cookie.
# AUTH_COOKIE_SECURE="false"

# Optional inquiry notifications.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# RESEND_API_KEY=""
# TRADE_DESK_EMAIL="trade@pgm-trading.com"
